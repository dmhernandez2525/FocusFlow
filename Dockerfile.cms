# FocusFlow CMS (Strapi v4) production Dockerfile (created 2026-05-18 for AWS).
# Debian bookworm-slim (sharp/libvips need glibc; Alpine often fails).
# Builds services/cms (Strapi v4 + TypeScript) from monorepo root.
#
# Build from repo root:  docker build -f Dockerfile.cms -t focusflow-cms .

FROM public.ecr.aws/docker/library/node:20-bookworm-slim AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ libvips-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN npm install -g pnpm@9

# ---- builder stage (single-pass install + build to keep pnpm workspace symlinks intact) ----
FROM base AS builder
COPY . .
RUN pnpm install --frozen-lockfile
RUN cd packages/types && pnpm run build || true
RUN cd packages/utils && pnpm run build || true
ENV NODE_ENV=production
# Strapi reads admin/api/server config at build time and requires several env vars
# to exist (their values don't matter at build time). Runtime values come from
# AWS Secrets Manager via the ECS task definition.
ENV ADMIN_JWT_SECRET=build-time-placeholder-replaced-at-runtime
ENV API_TOKEN_SALT=build-time-placeholder-replaced-at-runtime
ENV TRANSFER_TOKEN_SALT=build-time-placeholder-replaced-at-runtime
ENV JWT_SECRET=build-time-placeholder-replaced-at-runtime
ENV APP_KEYS=key1,key2,key3,key4
ENV DATABASE_CLIENT=sqlite
ENV DATABASE_FILENAME=/tmp/build.db
ENV AWS_ACCESS_KEY_ID=build-time-placeholder
ENV AWS_SECRET_ACCESS_KEY=build-time-placeholder
ENV AWS_REGION=us-east-1
ENV S3_BUCKET=build-time-placeholder
ENV SENDGRID_API_KEY=build-time-placeholder
# The current CMS has TypeScript debt in Strapi controller/service typings.
# Compile server code with diagnostics ignored, then run API-only in production.
RUN cd services/cms \
 && node -e "require('@strapi/strapi').compile({ appDir: process.cwd(), ignoreDiagnostics: true }).catch((error) => { console.error(error); process.exit(1); })"

# ---- runner stage ----
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=1337
ENV SERVE_ADMIN_PANEL=false
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs --create-home strapi

# Copy the full installed app from builder so Strapi has node_modules + workspace symlinks.
# This is simpler and safer than re-installing prod deps; Strapi loads source at runtime.
COPY --from=builder --chown=strapi:nodejs /app /app

# Strapi needs writable cache/tmp/uploads dirs.
RUN mkdir -p /app/services/cms/.cache /app/services/cms/.tmp /app/services/cms/public/uploads \
 && chown -R strapi:nodejs /app/services/cms/.cache /app/services/cms/.tmp /app/services/cms/public

USER strapi
EXPOSE 1337
WORKDIR /app/services/cms
CMD ["pnpm", "start"]
